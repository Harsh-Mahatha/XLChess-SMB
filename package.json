{
  "name": "xlchess-smb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "XLChess Social Media Bot (SMB): backend API, home-PC AI worker and shared contracts",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @smb/shared && npm run build -w @smb/api && npm run build -w @smb/worker",
    "dev:api": "npm run dev -w @smb/api",
    "dev:worker": "npm run dev -w @smb/worker",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "config:validate": "npm run config:validate -w @smb/api",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration:new": "supabase migration new",
    "db:pull": "npm run db:pull -w @smb/api",
    "research:build": "npm run research:build -w @smb/api --",
    "story:select": "npm run story:select -w @smb/api --",
    "candidates:generate": "npm run candidates:generate -w @smb/api --",
    "installer:package": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-package.ps1",
    "installer:test": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Import-Module Pester; Invoke-Pester installer/tests\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "pg": "^8.23.1",
    "prettier": "^3.4.2",
    "supabase": "^2.0.0",
    "testcontainers": "^12.2.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
