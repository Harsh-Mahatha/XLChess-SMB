# ---- API ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Deployment environment: development | staging | production
SMB_DEPLOYMENT=development
# Which deployment the X credentials belong to (must match SMB_DEPLOYMENT when X keys are set)
X_CREDENTIALS_DEPLOYMENT=development
# Number of reverse proxies in front of the API (0 disables trust proxy)
SMB_TRUST_PROXY=0
# Require HTTPS on /worker/v1/* (defaults to true in production, false otherwise)
# SMB_REQUIRE_HTTPS=false

# Supabase project dedicated to SMB (NOT the XLChess project)
# Pooled connection for the app, direct connection for Prisma introspection.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres?schema=smb
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres?schema=smb
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_SERVICE_ROLE_KEY=

# XLChess custom-auth JWT verification (fill in once confirmed - see docs/ARCHITECTURE.md section 12)
XLCHESS_JWT_ALG=HS256
XLCHESS_JWT_SECRET=
XLCHESS_JWKS_URL=
XLCHESS_JWT_ISSUER=
XLCHESS_JWT_AUDIENCE=
XLCHESS_JWT_USER_ID_CLAIM=sub
# The XLChess backend mints one short-lived token per call with an smb_role claim (reviewer or admin).

# How long an image link given to a reviewer works (seconds, 30 to 3600).
SMB_SIGNED_URL_SECONDS=300

# Publishing safety ceiling: dry_run | sandbox | live. The highest mode allowed; an admin chooses the mode up to this ceiling. Live also needs SMB_ALLOW_LIVE_PUBLISH=true and SMB_DEPLOYMENT=production.
SMB_PUBLISH_MODE=dry_run
SMB_ALLOW_LIVE_PUBLISH=false

# AI provider for server-side use: stub | worker
SMB_AI_PROVIDER=stub
# Seconds a claimed worker GPU job lease lasts before expiring (60 to 3600)
SMB_WORKER_LEASE_SECONDS=600
# Seconds between worker job claim polls when idle (2 to 300)
SMB_WORKER_POLL_SECONDS=10
# Optional target worker version advertised to paired workers
# SMB_WORKER_TARGET_VERSION=
# Default LLM model name advertised to paired workers
SMB_WORKER_LLM_MODEL=qwen3.5:9b
# Default image model name advertised to paired workers
SMB_WORKER_IMAGE_MODEL=z-image-turbo

# ---- X publishing (1.13) ----
# Dev and prod use different X apps and accounts; production values live only on the production host.
# In dry_run, all X keys may remain empty.
# In sandbox or live mode, all four OAuth keys and X_USER_ID are required.
# X_API_BASE_URL=https://api.x.com
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# X_USER_ID=
# X_USERNAME=
# X_HTTP_TIMEOUT_MS=15000
# X_RECONCILE_DELAY_SECONDS=60
# X_RECONCILE_MAX_LOOKUPS=5

# Image sourcing (1.8). Wikimedia asks for a way to contact the operator in the User-Agent (a URL or an address).
SMB_CONTACT=
# Accept CC BY-SA photos (decision 2026-11-13).
IMAGE_ALLOW_SHARE_ALIKE=true

# ---- Worker (home PC) ----
SMB_API_URL=http://localhost:4000
# Device token is written by the installer pairing step, never hand-edited.

# ---- Scheduler (1.14) ----
# Creates posting opportunities from schedules. Off by default; production sets it to true.
# 1.17: the orchestrator tick + job runner, and the publisher loop (all off by default)
SMB_WORKFLOW_ENABLED=false
SMB_WORKFLOW_TICK_SECONDS=15
SMB_RUNNER_CONCURRENCY=2
SMB_PUBLISHER_ENABLED=false
SMB_PUBLISH_INTERVAL_SECONDS=30
SMB_SCHEDULER_ENABLED=false
SMB_SCHEDULER_INTERVAL_SECONDS=60

# ---- Monitoring, cost and quality KPIs (1.19) ----
# The day a post belongs to, and the posts a day needs to count towards the ten-day goal.
SMB_KPI_TIMEZONE=UTC
SMB_KPI_REQUIRED_DAILY_VOLUME=1
# Problems are logged when they open and when they clear (runs with SMB_WORKFLOW_ENABLED).
SMB_ALERT_INTERVAL_SECONDS=60
SMB_ALERT_WORKER_OFFLINE_MINUTES=10
SMB_ALERT_POLLER_FAILURES=3
SMB_ALERT_REVIEW_WAIT_HOURS=6


# ---- Event detection (1.16) ----
# One loop runs every event detector, including the World Championship feed sync (1.15).
# Each detector keeps its own cadence and backs off while its sources fail. Off by default.
SMB_EVENTS_ENABLED=false
# How often the loop checks which detectors are due (seconds).
SMB_EVENTS_TICK_SECONDS=30
# Two sources must agree on a game result for this long before it is corroborated (seconds).
SMB_EVENTS_STABILITY_SECONDS=120
# Deprecated 1.15 names, still honoured when the SMB_EVENTS_* names are unset:
# SMB_CHAMPIONSHIP_SYNC_ENABLED=false
# SMB_CHAMPIONSHIP_SYNC_SECONDS=60
