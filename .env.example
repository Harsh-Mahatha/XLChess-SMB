# ---- API ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Supabase project dedicated to SMB (NOT the XLChess project)
# Pooled connection for the app, direct connection for Prisma introspection.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=smb
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=smb
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# XLChess custom-auth JWT verification (fill in once confirmed - see docs/ARCHITECTURE.md section 12)
XLCHESS_JWT_ALG=HS256
XLCHESS_JWT_SECRET=
XLCHESS_JWKS_URL=
XLCHESS_JWT_ISSUER=
XLCHESS_JWT_AUDIENCE=
XLCHESS_JWT_USER_ID_CLAIM=sub

# Publishing safety: dry_run | sandbox | live. Live also needs SMB_ALLOW_LIVE_PUBLISH=true.
SMB_PUBLISH_MODE=dry_run
SMB_ALLOW_LIVE_PUBLISH=false

# AI provider for server-side use: stub | worker
SMB_AI_PROVIDER=stub

# ---- Worker (home PC) ----
SMB_API_URL=http://localhost:4000
# Device token is written by the installer pairing step, never hand-edited.
