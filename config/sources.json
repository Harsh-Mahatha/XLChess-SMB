      "kind": "data",
      "name": "Lichess Broadcasts",
      "enabled": true,
      "reliability": "structured_feed",
      "access": {
        "method": "api",
        "baseUrl": "https://lichess.org/api/",
        "auth": "none",
        "termsUrl": "https://lichess.org/terms-of-service"
      },
      "policy": {
        "status": "approved",
        "verifiedAt": "2026-11-04",
        "automatedRetrieval": true,
        "attributionRequired": true,
        "notes": "Public documented API; terms allow personal and commercial use of the API within reasonable limits. Lichess asks for one request at a time and a pause of at least a minute after HTTP 429. Unauthenticated broadcast endpoints are heavily rate-limited and may stop working; switch to a token if so. See docs/sources/D3-lichess-broadcasts.md."
      },
      "capabilities": ["events", "games"],
      "limits": {
        "maxConcurrent": 1,
        "minIntervalMs": 1000,
        "rateLimitBackoffMs": 60000,
        "timeoutMs": 30000,
        "maxRetries": 2,
        "cacheTtlSeconds": { "events": 300, "games": 60 }
      }
