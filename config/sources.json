      "policy": {
        "status": "approved",
        "verifiedAt": "2026-11-13",
        "automatedRetrieval": true,
        "attributionRequired": true,
        "notes": "Public MediaWiki API, no key. Licence data comes from imageinfo extmetadata. Players are matched through Wikidata (FIDE id, P1440) which is part of this source. Only commercial-use, modification-allowed licences are accepted; CC BY-SA is accepted (decision 2026-11-13). See docs/sources/I1-wikimedia-commons.md."
      },
